{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_dynamic_csv",
						"type": "DatasetReference"
					},
					"name": "sourcedatset"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ADLSLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sinkDelta"
				}
			],
			"transformations": [
				{
					"name": "derivedColumnUppercase"
				},
				{
					"name": "selecttokeepcolumn"
				},
				{
					"name": "toPerformUpsert"
				}
			],
			"scriptLines": [
				"source(output(",
				"          location_id as short,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          latitude as double,",
				"          longitude as double,",
				"          last_updated_timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourcedatset",
				"sourcedatset derive(country = upper(country)) ~> derivedColumnUppercase",
				"derivedColumnUppercase select(mapColumn(",
				"          location_id,",
				"          city,",
				"          state,",
				"          country,",
				"          last_updated_timestamp",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selecttokeepcolumn",
				"selecttokeepcolumn alterRow(upsertIf(1==1)) ~> toPerformUpsert",
				"toPerformUpsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'sink',",
				"     folderPath: 'deltaset',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['location_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDelta"
			]
		}
	}
}